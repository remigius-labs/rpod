+/* RPod: the shutdown message on the dimmed painting, cream text, no box */
+static void shutdown_message(const char *fmt, ...)
+{
+    char msg[64];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(msg, sizeof(msg), fmt, ap);
+    va_end(ap);
+#if LCD_DEPTH == 16 && LCD_PIXELFORMAT == RGB565
+    /* the default full-screen viewport: a fresh struct here left its buffer pointer unset */
+    struct viewport *last_vp = lcd_set_viewport(NULL);
+    lcd_clear_viewport();
+    fb_data *row = FBADDR(0, 0);
+    for (int y = 0; y < LCD_HEIGHT; y++, row += lcd_current_viewport->buffer->stride)
+        for (int x = 0; x < LCD_WIDTH; x++)
+        {
+            unsigned px = row[x];
+            row[x] = ((((px >> 11) & 0x1f) * 89 >> 8) << 11) |
+                     ((((px >> 5) & 0x3f) * 89 >> 8) << 5) |
+                     ((px & 0x1f) * 89 >> 8);
+        }
+    int w, h;
+    lcd_setfont(FONT_UI);
+    lcd_getstringsize(msg, &w, &h);
+    lcd_set_drawmode(DRMODE_FG);
+    lcd_set_foreground(LCD_RGBPACK(232, 217, 181));
+    lcd_putsxy((LCD_WIDTH - w) / 2, (LCD_HEIGHT - h) / 2, msg);
+    /* gilt like the menu titles */
+    rpod_gilt_rect((LCD_WIDTH - w) / 2 - 1, (LCD_HEIGHT - h) / 2 - 1, w + 2, h + 2,
+                   LCD_RGBPACK(232, 217, 181));
+    lcd_update();
+    lcd_set_viewport(last_vp);
+#else
+    splash(0, msg);
+#endif
+}
+
